# Para Docker Compose: copie para .env e troque o token.
DASHBOARD_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
AUTO_SCAN=1
# AUTO_RENDER chama somente AutoClip, nunca o renderizador FFmpeg antigo.
AUTO_RENDER=1
POLL_SECONDS=30
MAX_SOURCE_SECONDS=7200

# Descoberta Twitch; credenciais reais ficam somente no ambiente privado.
TWITCH_ENABLED=0
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_POLL_SECONDS=900
TWITCH_DISCOVERY_MODE=auto
TWITCH_TRENDING_CATEGORIES=12
TWITCH_CLIPS_PER_CATEGORY=10
TWITCH_LOOKBACK_HOURS=24
# TWITCH_CATEGORY_IDS=1,2  # IDs exatos, até 12 categorias
# TWITCH_BROADCASTER_IDS=  # IDs dos criadores monitorados
# OAuth de usuario (channel:manage:clips ou editor:manage:clips) separado do token de app
TWITCH_AUTO_DOWNLOAD=1
# Preseleciona GTA VI com base em sinais de metadados antes de gastar IA.
TWITCH_AUTO_BATCH=5
TWITCH_GTA6_BATCH=5
TWITCH_AUTO_MIN_SCORE=78
TWITCH_AUTO_PER_CREATOR=2
TWITCH_AUTO_GTA6_ONLY=1
# Deep discovery across official Helix pagination; bounded for API quotas.
TWITCH_GTA6_WINDOW_HOURS=12
TWITCH_GTA6_PAGES_PER_WINDOW=3
TWITCH_EDITOR_ID=
TWITCH_USER_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Optional CPU-heavy local analysis; disabled in default lightweight Docker image.
SMART_SCENES=0
AUTO_TRANSCRIBE=0
# Demonstration generates only owned synthetic media, at most 3 jobs per data volume.
ENABLE_SYNTHETIC_DEMO=0
WHISPER_MODEL=base
WHISPER_LANGUAGE=pt
RENDER_MAX_FPS=30

# Radar multicategoria antes da virada configurável para GTA VI.
# Alvo operacional solicitado; alterar se o calendário oficial mudar.
TWITCH_GTA6_LAUNCH_AT=2026-11-19T03:00:00+00:00
# TWITCH_GAME_ID=   # optional exact GTA VI category ID, used only after launch

# Publicação desativada por padrão; tokens não significam autenticação validada.
PUBLISHING_ENABLED=0
PUBLISHING_AUTO_ENABLED=0
PUBLISHING_DAILY_LIMIT=5
PUBLISHING_MAX_POLLS=20
YOUTUBE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# No Windows, CLI AutoClip completa e Python 3.12 sao embutidos no ZIP em sidecar.
# Modelos LLM continuam externos: reutiliza Ollama local ou um provedor configurado.
# No Docker/Linux, CLI real AutoClip deve ser instalada separadamente.
AUTOCLIP_ENABLED=1
AUTOCLIP_BINARY=autoclip
AUTOCLIP_AUTO_IMPORT=1
AUTOCLIP_PROVIDER=ollama
AUTOCLIP_OLLAMA_MODEL=
# Modulo de observação visual independente; só usa modelo vision JA instalado
NEXUS_VISION_MODEL=
# Verifica métricas oficiais no máximo a cada 6h; nenhum valor inventado
NEXUS_PERFORMANCE_POLL=1
# Somente localhost; Tailscale Serve privado usa esta porta se livre
NEXUS_LOCAL_PORT=8855

# Postiz API (HTTPS em api.postiz.com); conectar canais na conta Postiz.
# Nunca versionar API keys e não habilitar dois publicadores do mesmo canal.
POSTIZ_ENABLED=0
POSTIZ_API_KEY=
POSTIZ_YOUTUBE_INTEGRATION_ID=
POSTIZ_TIKTOK_INTEGRATION_ID=
