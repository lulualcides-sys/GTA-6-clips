# Separate CPU-capable image for the OPTIONAL scene/transcription modules.
# This increases image size, memory and build time; default Dockerfile stays lean.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 libgl1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-ai.txt ./
RUN python -m pip install --no-cache-dir -r requirements-ai.txt
COPY clipforge ./clipforge
RUN useradd -r -u 10001 cliprunner && mkdir /app/data && chown cliprunner:cliprunner /app/data
USER cliprunner
ENV HOST=0.0.0.0 PORT=8000 CLIPS_DATA_DIR=/app/data HF_HOME=/app/data/model-cache OMP_NUM_THREADS=2
EXPOSE 8000
CMD ["python", "-m", "clipforge.web"]
