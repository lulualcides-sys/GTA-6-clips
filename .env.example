# Para Docker Compose: copie para .env e troque o token.
DASHBOARD_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
AUTO_SCAN=1
AUTO_RENDER=1
POLL_SECONDS=30
MAX_SOURCE_SECONDS=7200

# Descoberta Twitch; credenciais reais ficam somente no ambiente privado.
TWITCH_ENABLED=0
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_POLL_SECONDS=900
TWITCH_DISCOVERY_MODE=auto
TWITCH_TRENDING_CATEGORIES=12
TWITCH_CLIPS_PER_CATEGORY=10
TWITCH_LOOKBACK_HOURS=24
# TWITCH_CATEGORY_IDS=1,2  # IDs exatos, até 12 categorias
# TWITCH_BROADCASTER_IDS=  # IDs dos criadores monitorados
# TWITCH_USER_ACCESS_TOKEN=  # somente CLI oficial de download com concessão específica

# Optional CPU-heavy local analysis; disabled in default lightweight Docker image.
SMART_SCENES=0
AUTO_TRANSCRIBE=0
# Demonstration generates only owned synthetic media, at most 3 jobs per data volume.
ENABLE_SYNTHETIC_DEMO=0
WHISPER_MODEL=base
WHISPER_LANGUAGE=pt
RENDER_MAX_FPS=30

# Radar multicategoria antes da virada configurável para GTA VI.
# Alvo operacional solicitado; alterar se o calendário oficial mudar.
TWITCH_GTA6_LAUNCH_AT=2026-11-19T03:00:00+00:00
# TWITCH_GAME_ID=   # optional exact GTA VI category ID, used only after launch

# Publicação desativada por padrão; tokens não significam autenticação validada.
PUBLISHING_ENABLED=0
PUBLISHING_AUTO_ENABLED=0
PUBLISHING_DAILY_LIMIT=5
PUBLISHING_MAX_POLLS=20
YOUTUBE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# AutoClip opcional: CLI isolada, dependências pesadas fora do aplicativo Nexus.
# Instalar em Python 3.11/3.12 independente; conferir 'autoclip doctor'.
AUTOCLIP_ENABLED=0
AUTOCLIP_BINARY=autoclip

# Postiz API (HTTPS em api.postiz.com); conectar canais na conta Postiz.
# Nunca versionar API keys e não habilitar dois publicadores do mesmo canal.
POSTIZ_ENABLED=0
POSTIZ_API_KEY=
POSTIZ_YOUTUBE_INTEGRATION_ID=
POSTIZ_TIKTOK_INTEGRATION_ID=
