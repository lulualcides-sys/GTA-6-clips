# Para Docker Compose: copie para .env e troque o token.
DASHBOARD_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
AUTO_SCAN=1
AUTO_RENDER=1
POLL_SECONDS=30
MAX_SOURCE_SECONDS=7200

# Twitch discovery metadata only; create application at https://dev.twitch.tv/console
TWITCH_ENABLED=0
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_POLL_SECONDS=900
# TWITCH_GTA5_GAME_ID=  # optional exact GTA V category ID before launch

# Optional CPU-heavy local analysis; disabled in default lightweight Docker image.
SMART_SCENES=0
AUTO_TRANSCRIBE=0
# Demonstration generates only owned synthetic media, at most 3 jobs per data volume.
ENABLE_SYNTHETIC_DEMO=0
WHISPER_MODEL=base
WHISPER_LANGUAGE=pt

# Focus GTA V until Nov 18; auto-switch to GTA VI from Nov 19 (São Paulo).
# Rockstar launch: 19 Nov 2026 00:00 in São Paulo (UTC-03).
TWITCH_GTA6_LAUNCH_AT=2026-11-19T03:00:00+00:00
# TWITCH_GAME_ID=   # optional exact GTA VI category ID, used only after launch
